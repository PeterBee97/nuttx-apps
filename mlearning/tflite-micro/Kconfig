#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TFLITEMICRO
	bool "TFLiteMicro"
	default n
	depends on SYSTEM_FLATBUFFERS && MATH_GEMMLOWP && MATH_KISSFFT && MATH_RUY

if TFLITEMICRO
config TFLITEMICRO_DEBUG
	bool "Print tflite-micro's debug message"
	default n

config TFLITEMICRO_TOOL
	bool "tflite-micro cmdline tool"
	default n

config TFLITEMICRO_SYSLOG
	bool "tflite-micro syslog backend"
	default n

if TFLITEMICRO_SYSLOG

config TFLITEMICRO_SYSLOG_LEVEL
	int "tflite-micro syslog level"
	default 6
	---help---
		Syslog level mapping of tflm, This log level mapping is consistent
		with the nuttx syslog level, please refer to syslog.h:

		define LOG_EMERG     0  /* System is unusable */
		define LOG_ALERT     1  /* Action must be taken immediately */
		define LOG_CRIT      2  /* Critical conditions */
		define LOG_ERR       3  /* Error conditions */
		define LOG_WARNING   4  /* Warning conditions */
		define LOG_NOTICE    5  /* Normal, but significant, condition */
		define LOG_INFO      6  /* Informational message */
		define LOG_DEBUG     7  /* Debug-level message */

endif # TFLITEMICRO_SYSLOG

if TFLITEMICRO_TOOL
config TFLITEMICRO_TOOL_PRIORITY
	int "tflite-micro tool priority"
	default 100

config TFLITEMICRO_TOOL_STACKSIZE
	int "tflite-micro tool stacksize"
	default 4096

endif # TFLITEMICRO_TOOL

config TFLITEMICRO_HELLOWORLD
	bool "Enable Tflite-micro hello world example"
	default n

if TFLITEMICRO_HELLOWORLD
config TFLITEMICRO_HELLOWORLD_PRIORITY
	int "Tflite-micro hello world priority"
	default 100

config TFLITEMICRO_HELLOWORLD_STACKSIZE
	int "Tflite-micro hello world stacksize"
	default 4096

endif # TFLITEMICRO_HELLOWORLD

config TFLITEMICRO_ETHOSU
	bool "Arm Ethos-U custom operator"
	default n
	depends on AI_ENGINE_ETHOSU
	help
		Build the TFLite Micro Ethos-U custom operator and connect it to a
		NuttX Ethos-U AI engine character device.

if TFLITEMICRO_ETHOSU

config TFLITEMICRO_ETHOSU_DEVPATH
	string "Ethos-U device path"
	default "/dev/ethosu0"

endif # TFLITEMICRO_ETHOSU

config TFLITEMICRO_ETHOSU_VWW
	bool "Ethos-U55 VWW96 inference example"
	default n
	depends on TFLITEMICRO_ETHOSU
	help
		Embed an Apache-2.0 Vela-compiled visual wake-word model and add
		the tflm_ethosu_vww command.  It runs one zero-input inference
		and reports output values, elapsed time and NPU PMU cycles.

if TFLITEMICRO_ETHOSU_VWW

config TFLITEMICRO_ETHOSU_VWW_PRIORITY
	int "Ethos-U55 example priority"
	default 100

config TFLITEMICRO_ETHOSU_VWW_STACKSIZE
	int "Ethos-U55 example stack size"
	default 8192

config TFLITEMICRO_ETHOSU_VWW_ARENA_SIZE
	int "Ethos-U55 example tensor arena size"
	default 131072
	range 98304 262144

endif # TFLITEMICRO_ETHOSU_VWW

config TFLITEMICRO_TITAN_INTENT
	bool "Titan U55 local speech models"
	default n
	depends on TFLITEMICRO_ETHOSU
	select AUDIOUTILS_TITAN_INTENT
	select AUDIOUTILS_TITAN_VOICEFE
	select AUDIOUTILS_TITAN_VOICEFE_FEATURES
	help
		Embed two INT8 Vela models and static NPU-visible tensor arenas.
		The model pair and quantization metadata must match the shared
		fixed-point feature extractor.

if TFLITEMICRO_TITAN_INTENT

config TFLITEMICRO_TITAN_INTENT_WAKE_ARENA
	int "Wake tensor arena bytes"
	default 32768
	range 16384 32768

config TFLITEMICRO_TITAN_INTENT_COMMAND_ARENA
	int "Command tensor arena bytes"
	default 65536
	range 24576 65536

config TFLITEMICRO_TITAN_INTENT_ONLY
	bool "Build only operators used by Titan intent"
	default y
	depends on !TFLITEMICRO_TOOL && !TFLITEMICRO_HELLOWORLD
	depends on !TFLITEMICRO_ETHOSU_VWW && !MLEARNING_CMSIS_NN
	help
		Exclude unrelated CPU inference kernels. The model pair uses
		Ethos-U and optionally a static reshape at its boundary.

endif # TFLITEMICRO_TITAN_INTENT
endif # TFLITEMICRO
